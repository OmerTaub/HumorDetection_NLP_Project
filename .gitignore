# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments and env files
.venv/
venv/
.env

# OS/editor
.DS_Store
.idea/
.vscode/

# Notebooks
.ipynb_checkpoints/

# Data (ignore contents, keep directory via .gitkeep)
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/*.csv
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/*.csv

# Experiment outputs and results (ignore contents, keep dir via .gitkeep)
/experiments/*
!/experiments/.gitkeep
/results/*
!/results/.gitkeep
/logs/*
!/logs/.gitkeep

# Model artifacts
*.pt
*.bin
*.ckpt


